# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
musicle
musicle.exe

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.zip

# Config and state files (sensitive data)
profiles/
state/config.json
state/*.json

# Python engine files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/

# NOTE: the embedded engine venv at internal/engine/engine_venv is deliberately
# COMMITTED (it is the runtime download engine). The generic Python ignores
# above (lib/, *.so, ...) would exclude it, so we re-include it explicitly.
# The prepare working dir (assets/engine) stays ignored — it is only an
# intermediate used to build the committed copy.
!internal/engine/engine_venv/
!internal/engine/engine_venv/**
!internal/engine/engine_ffmpeg/
!internal/engine/engine_ffmpeg/**
assets/engine/venv/
assets/engine/ffmpeg/

# AppImage build artifacts
*.AppImage
musicle-cli*.AppDir/
appimagetool

# Build output
build/

# Embedded engine assets (generated by scripts/prepare-engine.sh, then embedded
# into the binary). These ARE committed so a fresh clone can `go build` a fully
# self-contained binary without re-running prepare-engine.sh.
